# Development-only placeholders. Copy to .env and change every secret.
# Never commit a real .env file.
POSTGRES_PASSWORD=sentinel_dev_only
POSTGRES_APP_PASSWORD=sentinel_runtime_dev_only
POSTGRES_MIGRATOR_PASSWORD=sentinel_migrator_dev_only

SENTINEL_ENV=development
SECRET_KEY=replace-with-a-long-random-string
# Generate a private URL-safe base64 key from 32 random bytes for production.
# MFA_ENCRYPTION_KEY=
# Use a separate URL-safe base64 key (32 random bytes) for cloud provider credentials.
# CLOUD_CONNECTOR_ENCRYPTION_KEY=
# Optional metrics scrape token. Use at least 32 random characters and store privately.
# METRICS_TOKEN=
# Optional single-provider OIDC SSO for this self-hosted instance. Register the exact callback URI.
# OIDC_ISSUER=https://id.example.com/tenant/v2.0
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=https://xdr.example.com/api/v1/auth/oidc/callback
DATABASE_URL=postgresql+psycopg://sentinel_runtime:sentinel_runtime_dev_only@postgres:5432/sentinel
MIGRATION_DATABASE_URL=postgresql+psycopg://sentinel_migrator:sentinel_migrator_dev_only@postgres:5432/sentinel
REDIS_URL=redis://redis:6379/0
SENTINEL_JOB_RUNNER=celery
CORS_ORIGINS=http://127.0.0.1:8080,http://127.0.0.1:5173
SENTINEL_BOOTSTRAP_ADMIN_EMAIL=admin@localhost.local
SENTINEL_BOOTSTRAP_ADMIN_PASSWORD=change-me-now
# Create this user in the app with the ingestion_service role; never reuse the admin login.
SENTINEL_SENSOR_EMAIL=sensor@localhost.local
SENTINEL_SENSOR_PASSWORD=replace-with-a-separate-long-random-password
MAX_UPLOAD_BYTES=10485760
MAX_UPLOAD_ROWS=20000
RETENTION_DAYS=90
UPLOAD_RETENTION_DAYS=30
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_HOURS=8

# Host-side local venv (not Compose) example; set both URLs for an isolated runtime role:
# DATABASE_URL=postgresql+psycopg://sentinel_runtime:sentinel_runtime_dev_only@127.0.0.1:5432/sentinel
# MIGRATION_DATABASE_URL=postgresql+psycopg://sentinel_migrator:sentinel_migrator_dev_only@127.0.0.1:5432/sentinel
# REDIS_URL=redis://127.0.0.1:6379/0
# SENTINEL_JOB_RUNNER=thread

# Reverse proxies whose X-Forwarded-For header is believed (addresses, CIDR
# ranges or host names). The Compose default trusts only the bundled proxies.
# Add your own TLS reverse proxy here, otherwise audit records and rate limits
# see the proxy's address instead of the client's.
# TRUSTED_PROXIES=frontend,tls-proxy
